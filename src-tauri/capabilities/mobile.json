{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-save",
  "description": "Save-as and download handoff on mobile (desktop uses browser Blob downloads)",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "iOS"
  ],
  "permissions": [
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        }
      ]
    }
  ]
}
