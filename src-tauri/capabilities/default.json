{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "opener:default",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    }
  ]
}
