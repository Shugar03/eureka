{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing of the production frontend (unit tests only: e2e are not run per mutant). Test infrastructure (src/e2e, src/test) and pure type files are not mutated. Incremental: only changed code is re-tested. Report: reports/mutation/frontend.html",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/e2e/**",
    "!src/test/**",
    "!src/main.tsx",
    "!src/types.ts",
    "!src/vite-env.d.ts"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 20000,
  "reporters": [
    "clear-text",
    "html",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/frontend.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/frontend.json"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "ignorePatterns": [
    "src-tauri/target",
    "src-tauri/mutants.out*",
    "src-tauri/gen",
    "dist",
    "coverage",
    "reports",
    ".e2e",
    "tests/e2e",
    "tests/desktop",
    "features",
    "docs",
    "*.log"
  ]
}
