{
  "name": "eureka",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "tsc && vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "release": "node scripts/release.cjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "fake-provider": "node tests/fake-provider/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:rust",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:coverage": "vitest run --coverage && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html --output-dir coverage/rust",
    "test:e2e": "e2e run --headed",
    "bench:library": "vitest run src/lib/bookText.bench.test.ts && cd src-tauri && cargo test editorial_benchmark -- --nocapture",
    "test:e2e:desktop": "e2e run --config e2e.desktop.config.ts --headed",
    "test:e2e:ci": "e2e run && e2e run --config e2e.desktop.config.ts",
    "test:visual:update": "e2e run tests/e2e/visual.e2e.ts --update-snapshots",
    "test:all": "npm test && npm run build:debug && npm run test:e2e && npm run test:e2e:desktop",
    "test:mutants": "node scripts/mutants.mjs --jobs 4",
    "test:mutants:frontend": "stryker run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.79",
    "@e2e-dev/web": "^0.15.3",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.154",
    "axe-core": "^4.14.0",
    "e2e": "^0.21.3",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
